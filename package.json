{
  "name": "todo-list-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:web": "corepack pnpm --filter @todo-list/web dev",
    "dev:mobile": "corepack pnpm --filter @todo-list/mobile start",
    "build": "corepack pnpm --filter @todo-list/web build",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "corepack pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  }
}
