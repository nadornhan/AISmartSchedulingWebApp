# Copy this file to .env.production only for a local production-like run.
# On a hosting platform, configure the same values in its secret manager instead.

APP_ENVIRONMENT=production
POSTGRES_DB=chrono
POSTGRES_USER=chrono
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://chrono:replace-with-a-strong-database-password@postgres:5432/chrono
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

WEB_PORT=3000
API_PORT=8000
NEXT_PUBLIC_API_URL=https://api.example.com
# Optional for managed hosting; Compose defaults to its internal API service.
# API_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com
CORS_ALLOW_ORIGIN_REGEX=

UPLOAD_DIR=/app/uploads
AI_ENABLED=true
AI_REQUESTS_PER_USER_PER_MINUTE=10
GEMINI_API_KEY=replace-with-a-new-server-side-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=8
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_MAX_RETRIES=0
WEB_CONCURRENCY=2
